# NOVA RESCUE - Environment Variables Configuration
# Copy this file to .env or .env.local to configure your local setup.

# Google Gemini API Key for AI Root-Cause Analysis & Rescue Recommendations
# Optional: If not provided or invalid, NOVA RESCUE automatically operates seamlessly
# using its deterministic local fallback reasoning engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Selected Gemini Model (Default: gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Port Configuration (default is 3000 or 5173 depending on dev script)
PORT=3000
